{
  "name": "@marl1w/scrypted-reolink",
  "version": "0.1.4",
  "description": "Scrypted plugin that receives Reolink camera and NVR motion and AI events by Baichuan push (TCP 9000) over one connection per device, instead of polling the HTTP API.",
  "license": "Apache-2.0",
  "scripts": {
    "scrypted-setup-project": "scrypted-setup-project",
    "prescrypted-setup-project": "scrypted-package-json",
    "build": "scrypted-webpack",
    "prepublishOnly": "NODE_ENV=production scrypted-webpack",
    "scrypted-deploy": "scrypted-deploy",
    "scrypted-deploy-debug": "scrypted-deploy-debug",
    "scrypted-debug": "scrypted-debug",
    "scrypted-package-json": "scrypted-package-json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js",
    "build:probe": "tsc -p tsconfig.tools.json"
  },
  "keywords": [
    "scrypted",
    "plugin",
    "reolink",
    "baichuan",
    "motion"
  ],
  "scrypted": {
    "rollup": true,
    "name": "Reolink (Baichuan)",
    "type": "DeviceProvider",
    "interfaces": [
      "DeviceProvider",
      "DeviceCreator"
    ],
    "pluginDependencies": []
  },
  "dependencies": {
    "@scrypted/sdk": "^0.5.59"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5.6.0"
  },
  "author": "marl1w",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/marl1w/scrypted-reolink.git"
  },
  "homepage": "https://github.com/marl1w/scrypted-reolink#readme",
  "bugs": {
    "url": "https://github.com/marl1w/scrypted-reolink/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
